# Docker Compose env for Sahra Marketing.
#
#   cp .env.docker.example .env.docker
#   docker compose up -d --build
#
# Deliberately named .env.docker, not .env — this project's real .env holds
# production cPanel secrets, and docker-compose.yml must never touch it
# (Compose auto-loads a file literally named .env for ${VAR} substitution,
# which would silently pull in the wrong credentials). Loaded into the
# app/queue/scheduler/migrate containers via env_file: in docker-compose.yml.
# DB_HOST/DB_DATABASE/DB_USERNAME/DB_PASSWORD are overridden to match the db
# service in docker-compose.yml regardless of what's set below — edit both
# files together if you change the database credentials.

APP_NAME="Sahra"
APP_ENV=local
APP_KEY=base64:Z4rGMGwcn0ylT8x3UXzUdZdx+JTH4YDkm442hPGNHWU=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database ---------------------------------------------------------------
# Must match the `db` service's MARIADB_* credentials in docker-compose.yml
# (currently sahra/sahra/secret) — docker-compose.yml also sets these four as
# explicit overrides, so changing them here alone isn't enough.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=sahra
DB_USERNAME=sahra
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

# No SMTP required to boot — mail is logged instead. Set real SMTP_* values
# to actually send contact-form/newsletter emails.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@sahra.example"
MAIL_FROM_NAME="${APP_NAME}"

CONTACT_NOTIFICATION_EMAIL="hello@sahra.example"

# Seeded on first `php artisan db:seed` — change before seeding a real deploy.
ADMIN_EMAIL=admin@sahra.example
ADMIN_PASSWORD=ChangeMe!2026
ADMIN_NAME="Sahra Admin"

VITE_APP_NAME="${APP_NAME}"
