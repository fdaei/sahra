        "@vitejs/plugin-vue": "^5.2.1",
        "@vue/eslint-config-typescript": "^14.1.4",
        "autoprefixer": "^10.4.20",
        "concurrently": "^9.1.0",
        "eslint": "^10.8.0",
        "eslint-plugin-vue": "^10.10.0",
        "laravel-vite-plugin": "^1.1.1",
        "postcss": "^8.4.49",
        "prettier": "^3.4.1",
        "tailwindcss": "^3.4.16",
        "tailwindcss-logical": "^3.0.1",
        "typescript": "^5.7.2",
