APP_NAME="Sahra"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://sahramarketing.com
SEO_CANONICAL_ORIGIN=https://sahramarketing.com
INERTIA_SSR_ENABLED=false

# English is the default entry language; explicit /fa and /ar remain available.
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=single
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpanelaccount_sahra
DB_USERNAME=cpanelaccount_sahra
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public
# Set the actual absolute path from cPanel. No storage symlink is required.
PUBLIC_STORAGE_ROOT=/home/cpanelaccount/public_html/storage

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=hello@sahramarketing.com
MAIL_FROM_NAME="${APP_NAME}"
CONTACT_NOTIFICATION_EMAIL=hello@sahramarketing.com
